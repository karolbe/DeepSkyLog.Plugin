<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DeepSkyLog.NINAPlugin</RootNamespace>
    <AssemblyName>DeepSkyLog.NINAPlugin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!--
      3.1.0.9001: the earliest stable package with ISequenceMediator.SequenceStarting/SequenceFinished,
      which live session telemetry uses to bound a session. IFocuserConsumer.NewAutoFocusPoint and
      AutoFocusRunStarting, and DomeInfo.ApplicationFollowing, are 3.2-only and unused by this build;
      TelemetryCollector gets autofocus summaries from IImageHistoryVM.AutoFocusPoints instead, and
      dome-slaved status from DriverFollowing alone. MinimumApplicationVersion in AssemblyInfo.cs must
      match this version exactly: NINA's plugin loader resolves dependencies by exact assembly version.
    -->
    <PackageReference Include="NINA.Plugin" Version="3.1.0.9001" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.Settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.Settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins\3.0.0&quot; (&#xD;&#xA;  echo &quot;Creating $(PlatformName) Plugins folder&quot;&#xD;&#xA;  mkdir &quot;%25localappdata%25\NINA\Plugins\3.0.0&quot;&#xD;&#xA;)&#xD;&#xA;if not exist &quot;%25localappdata%25\NINA\Plugins\3.0.0\DeepSkyLog&quot; (&#xD;&#xA;  echo &quot;Creating $(PlatformName) Plugins DeepSkyLog folder&quot;&#xD;&#xA;  mkdir &quot;%25localappdata%25\NINA\Plugins\3.0.0\DeepSkyLog&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;echo &quot;Copying $(PlatformName) $(TargetFileName)&quot;&#xD;&#xA;xcopy &quot;$(TargetPath)&quot; &quot;%25localappdata%25\NINA\Plugins\3.0.0\DeepSkyLog&quot; /h/i/c/k/e/r/y&#xD;&#xA;  " />
  </Target>
</Project>